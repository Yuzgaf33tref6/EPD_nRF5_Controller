<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 联网权限：只有「检查更新」需要（用户主动点击时才联网）。
         Flutter 模板默认只在 debug/profile 清单里加这一条，release 包里没有，
         会导致 dart:io 的 HttpClient 连域名都解析不了
         （报 SocketException: Failed host lookup: 'api.github.com'）。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- BLE 相关权限。
         - API 18..30：老式蓝牙权限 + 扫描需要定位权限
         - API 31+（Android 12）：改用 BLUETOOTH_SCAN / BLUETOOTH_CONNECT
         neverForLocation 告诉系统「扫描结果不用于推断位置」，这样 Android 12+
         不会强制索要定位权限；而 location 两条仍保留 maxSdkVersion=30 供老系统使用。 -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- BLE 需要一个支持 BLE 的硬件，显式声明为非必需，让不支持的设备仍能安装。 -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <application
        android:label="EPD Controller"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme">
            <!-- 引擎首帧前切换到 NormalTheme，避免启动白屏闪烁 -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 声明使用 Flutter v2 embedding。
             缺失这一项时 flutter 工具会判定项目使用「已被删除的 v1 embedding」并直接失败；
             另外 AGP 8 起 manifest 的 package="" 属性必须移除，命名空间改由 build.gradle.kts 的 namespace 提供。 -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
